generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String?        @unique
  phone         String?        @unique
  password      String
  role          String         @default("USER")
  favorites     Favorite[]
  orders        Order[]
  wallet        Wallet?
  transactions  Transaction[]
  notifications Notification[]
  reviews       Review[]
  cartItems     CartItem[]
  createdAt     DateTime       @default(now())
}

model Resource {
  id          String     @id @default(cuid())
  title       String     @unique
  description String
  category    String
  country     String
  badge       String?
  followers   Int?
  tags        String[]
  platform    String
  link        String
  image       String?
  price       Float?
  status      String     @default("ACTIVE")
  createdAt   DateTime   @default(now())
  favorites   Favorite[]
  orders      Order[]
  reviews     Review[]
  cartItems   CartItem[]
}

model VerificationCode {
  id        String   @id @default(cuid())
  target    String
  code      String
  type      String   // EMAIL | PHONE
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([target, code])
}

model Favorite {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  resource   Resource @relation(fields: [resourceId], references: [id])
  resourceId String
  createdAt  DateTime @default(now())

  @@unique([userId, resourceId])
}

model Order {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId    String
  resource      Resource       @relation(fields: [resourceId], references: [id])
  status        String         @default("PENDING")
  amount        Float?
  productLink   String?
  discountCode  String?
  finalPrice    Float?
  startDate     DateTime?
  endDate       DateTime?
  postLink      String?
  screenshotUrl String?
  message       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  transactions  Transaction[]
  notifications Notification[]
  review        Review?        @relation("ReviewOrder")
}

model Wallet {
  id           String        @id @default(cuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Float         @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
}

model Transaction {
  id          String   @id @default(cuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // TOPUP | DEDUCTION | REFUND
  amount      Float
  description String
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id])
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // ORDER_STATUS | BALANCE_TOPUP | ORDER_CREATED | SYSTEM
  title     String
  message   String
  read      Boolean  @default(false)
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id])
  createdAt DateTime @default(now())
}

model Review {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id])
  orderId    String   @unique
  order      Order    @relation("ReviewOrder", fields: [orderId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@unique([userId, resourceId, orderId])
}

model CartItem {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([userId, resourceId])
}
