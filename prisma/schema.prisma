generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ResourceStatus {
  ACTIVE
  HIDDEN
  SOLD_OUT
}

enum OrderStatus {
  PENDING
  RUNNING
  POSTED
  CONFIRMED
}

enum TransactionType {
  TOPUP
  DEDUCTION
  REFUND
}

enum NotificationType {
  ORDER_STATUS
  BALANCE_TOPUP
  ORDER_CREATED
  SYSTEM
}

enum VerificationType {
  EMAIL
  PHONE
}

enum PaymentMethod {
  WECHAT
  ALIPAY
}

enum PaymentRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id              String           @id @default(cuid())
  email           String?          @unique
  phone           String?          @unique
  password        String
  role            Role             @default(USER)
  nickname        String?
  avatar          String?
  favorites       Favorite[]
  orders          Order[]
  wallet          Wallet?
  transactions    Transaction[]
  notifications   Notification[]
  reviews         Review[]
  cartItems       CartItem[]
  paymentRequests PaymentRequest[]
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
}

model Resource {
  id          String         @id @default(cuid())
  title       String         @unique
  description String
  category    String
  categoryId  String?
  categoryRef Category?      @relation(fields: [categoryId], references: [id])
  country     String
  badge       String?
  followers   Int?
  tags        String[]
  platform    String
  link        String
  image       String?
  price       Decimal?       @db.Decimal(12, 2)
  status      ResourceStatus @default(ACTIVE)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  favorites   Favorite[]
  orders      Order[]
  reviews     Review[]
  cartItems   CartItem[]

  @@index([categoryId])
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  sort      Int        @default(0)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  resources Resource[]
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model VerificationCode {
  id        String           @id @default(cuid())
  target    String
  code      String
  type      VerificationType
  expiresAt DateTime         @db.Timestamptz(3)
  used      Boolean          @default(false)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  @@index([target, code])
}

model Favorite {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  resourceId String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, resourceId])
  @@index([resourceId])
}

model Order {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId    String?
  resource      Resource?      @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  status        OrderStatus    @default(PENDING)
  amount        Decimal?       @db.Decimal(12, 2)
  productLink   String?
  discountCode  String?
  finalPrice    Decimal?       @db.Decimal(12, 2)
  startDate     DateTime?      @db.Timestamptz(3)
  endDate       DateTime?      @db.Timestamptz(3)
  postLink      String?
  screenshotUrl String?
  message       String?
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  transactions  Transaction[]
  notifications Notification[]
  review        Review?        @relation("ReviewOrder")

  @@index([userId])
  @@index([resourceId])
}

model Wallet {
  id           String        @id @default(cuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Decimal       @default(0) @db.Decimal(12, 2)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  transactions Transaction[]
}

model Transaction {
  id          String          @id @default(cuid())
  walletId    String
  wallet      Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        TransactionType
  amount      Decimal         @db.Decimal(12, 2)
  description String
  orderId     String?
  order       Order?          @relation(fields: [orderId], references: [id])
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)

  @@index([walletId])
  @@index([userId])
  @@index([orderId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  orderId   String?
  order     Order?           @relation(fields: [orderId], references: [id])
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([orderId])
}

model Review {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId String?
  resource   Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  orderId    String   @unique
  order      Order    @relation("ReviewOrder", fields: [orderId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, resourceId, orderId])
  @@index([userId])
  @@index([resourceId])
}

model CartItem {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, resourceId])
  @@index([resourceId])
}

model PaymentQrCode {
  id        String           @id @default(cuid())
  type      PaymentMethod
  imageUrl  String
  label     String?
  active    Boolean          @default(true)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)
  requests  PaymentRequest[]
}

model PaymentRequest {
  id            String               @id @default(cuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Decimal              @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  status        PaymentRequestStatus @default(PENDING)
  qrCodeId      String?
  qrCode        PaymentQrCode?       @relation(fields: [qrCodeId], references: [id])
  orderId       String?
  note          String?
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@index([status])
  @@index([qrCodeId])
  @@index([orderId])
}
