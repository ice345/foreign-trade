DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/globalpush"
JWT_SECRET="replace-with-strong-secret-min-32-chars"
VERIFICATION_CODE_SECRET="replace-with-an-independent-strong-secret"
NEXT_PUBLIC_SITE_URL="https://globalpush.com"
NEXT_PUBLIC_BUSINESS_TZ="Asia/Shanghai"
NEXT_PUBLIC_BUSINESS_TZ_LABEL="业务地区"

# Resend (email). The From address must belong to a domain verified in Resend.
RESEND_API_KEY=re_xxxxx
NOTIFICATION_FROM_EMAIL=noreply@globalpush.io

# SMS: use stub only in development. Production should be aliyun or tencent.
SMS_PROVIDER=stub
ALIYUN_SMS_ACCESS_KEY_ID=xxxxx
ALIYUN_SMS_ACCESS_KEY_SECRET=xxxxx
ALIYUN_SMS_SIGN_NAME=xxxxx
ALIYUN_SMS_TEMPLATE_CODE=xxxxx
TENCENT_SMS_SECRET_ID=xxxxx
TENCENT_SMS_SECRET_KEY=xxxxx
TENCENT_SMS_SDK_APP_ID=xxxxx
TENCENT_SMS_SIGN_NAME=xxxxx
TENCENT_SMS_TEMPLATE_ID=xxxxx

# Cloudflare R2
R2_ACCOUNT_ID=xxxxx
R2_ACCESS_KEY_ID=xxxxx
R2_SECRET_ACCESS_KEY=xxxxx
R2_BUCKET_NAME=globalpush-files-preview
R2_MAX_FILE_BYTES=4194304
R2_GLOBAL_STORAGE_BYTES=8589934592
R2_USER_STORAGE_BYTES=209715200
R2_USER_DAILY_BYTES=41943040
R2_USER_DAILY_FILES=20
R2_MONTHLY_WRITE_OPS=800000
R2_MONTHLY_READ_OPS=8000000
CRON_SECRET=replace-with-random-secret-min-32-chars
